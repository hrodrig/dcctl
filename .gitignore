# Whitelist: ignore everything by default; only explicitly allowed paths are tracked.
# See .cursor/rules/gitignore-whitelist.mdc

*
.*
!.gitignore
!.dockerignore
!.cursor/
!.cursor/rules/
!.cursor/rules/*.mdc
!README.md
!VERSION
!LICENSE
!Makefile
!.goreleaser.yaml
!Dockerfile
!Dockerfile.release
!go.mod
!go.sum
!cmd/
!cmd/**
!internal/
!internal/**
!docs/
!docs/**
